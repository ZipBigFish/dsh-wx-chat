{
  "name": "@local/dsh-wx-chat",
  "version": "2.8.1",
  "private": true,
  "type": "module",
  "description": "WeChat-style DSH chat with per-turn avatar history, preset schemes, crop UI, responsive vector bubble frames, fixed-proportion characters, blue ocean bubbles, day/night palettes, and optional whale-wave switches.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/**/*",
    "assets/README.md",
    "assets/生成提示词.md",
    "assets/cat-skin.webp",
    "assets/cat-dark-skin.webp",
    "assets/ocean-skin.svg",
    "assets/ocean-dark-skin.svg",
    "assets/vector/*"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
